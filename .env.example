# tensor-pilot-ryan-vo environment variables
# Copy to .env and fill in values

# Application
APP_NAME=tensor-pilot-ryan-vo
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/tensor_pilot.db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (optional, non-secret)
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# OIDC/Keycloak
OIDC_ISSUER_URL=http://localhost:8081/realms/tensor-pilot
OIDC_CLIENT_ID=tensor-pilot
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/callback